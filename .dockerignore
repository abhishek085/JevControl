# Local state: model weights, experiment runs, caches - never belongs in the image
models/
.jevcontrol/
results/
*.trace.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Frontend: rebuilt fresh inside the image, node_modules never travels
frontend/node_modules/
frontend/dist/
jevcontrol/webui/

# VCS / IDE / docs - not needed at runtime
.git/
.github/
.idea/
.vscode/
docs/
*.md
!README.md
